# Optional: copy to .env. pnpm dev, pnpm start and pnpm pds:demo load it.
# Restart the command after editing. Existing shell variables take precedence.
# Local development works without this file or a PDS account.
DEV_PORT=5173
API_PORT=3000

# Production preview (pnpm build && pnpm start).
PORT=3000
HOST=127.0.0.1
APP_NAME=Hello Løftet

# The PDS that hosts your account. See docs/integrations.md.
# PDS_URL=https://your-pds.example
# Optional browser-facing address if different from PDS_URL.
# PDS_PUBLIC_URL=https://your-pds.example

# Only needed for pnpm pds:demo. Use a test account and its app password.
# Never prefix credentials with VITE_: Vite exposes those to the browser.
# PDS_IDENTIFIER=your-test-account.example
# PDS_APP_PASSWORD=
